# Variabel Lingkungan (*Environment Variables*) untuk Proyek Portofolio
# Berkas ini adalah contoh. Ganti nilai-nilai di bawah ini dengan kredensial asli Anda pada berkas .env (jangan komit berkas .env ke repositori).

# Contoh Konfigurasi API Pihak Ketiga (jika Anda ingin menambahkan interaksi dinamis nantinya)
API_KEY=masukkan_kunci_api_anda_di_sini
API_URL=https://api.contoh.com/v1

# Contoh Konfigurasi Layanan Pengiriman Email (misalnya EmailJS untuk formulir kontak)
EMAIL_SERVICE_ID=masukkan_id_layanan_email_anda
EMAIL_TEMPLATE_ID=masukkan_id_templat_email_anda
EMAIL_PUBLIC_KEY=masukkan_kunci_publik_email_anda

# Konfigurasi Lingkungan
NODE_ENV=development
